#!/bin/sh
# 🔐 Block commits that contain secrets (WiFi passwords, API keys, tokens…).
# Enable once per clone:  git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "🔐 gitleaks isn't installed, so this commit can't be checked for secrets."
  echo "   Install it (brew install gitleaks, or see CONTRIBUTING.md) and commit again."
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner -v
